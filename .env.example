# API
DATABASE_URL=postgres://arroba:arroba@localhost:5432/arroba_direta
PORT=3333
# Como o código de login chega ao usuário. "teste": sem SMS, o código aparece na tela do app.
# O envio por "sms" ainda não existe. Sem a variável vale "teste", exceto com NODE_ENV=production,
# em que a API não sobe sem ela.
CODIGO_MODO=teste
# Onde ficam as fotos e vídeos dos anúncios: "cloudinary", "local" ou "desligado".
# Sem a variável: "cloudinary" se CLOUDINARY_URL existir; "desligado" no Render; senão "local".
# MIDIA_ARMAZENAMENTO=local
# Conta do Cloudinary (painel do Cloudinary > Settings > API Keys > "API environment variable").
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Modo local: pasta dos arquivos (padrão apps/api/uploads) e o endereço da API que o app e o site
# enxergam, usado nos links das fotos. Para testar no celular, use o IP da máquina, como no app.
# MIDIA_PASTA_LOCAL=apps/api/uploads
# API_URL_PUBLICA=http://localhost:3333

# Site (Next.js)
API_URL=http://localhost:3333

# App (Expo) — use o IP da sua máquina na rede para testar no celular
EXPO_PUBLIC_API_URL=http://localhost:3333
