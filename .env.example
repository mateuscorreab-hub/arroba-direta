# API
DATABASE_URL=postgres://arroba:arroba@localhost:5432/arroba_direta
PORT=3333
# Como o código de login chega ao usuário. "teste": sem SMS, o código aparece na tela do app.
# "sms": chega por SMS pela Comtele. Sem a variável vale "teste", exceto com NODE_ENV=production,
# em que a API não sobe sem ela.
CODIGO_MODO=teste
# Chave dos códigos guardados no banco (HMAC), com pelo menos 32 caracteres. Obrigatória com "sms";
# sem ela, a versão de teste cria uma a cada vez que a API sobe.
# CODIGO_SEGREDO=
# Com "sms": teto de SMS em 24 horas, somando todos os números (padrão 100). Só algarismos.
# CODIGO_SMS_POR_DIA=100
# Com "sms": chave da Comtele (painel antigo: API > Chave de API; novo: Configurações > Chaves de API).
# COMTELE_API_KEY=
# Só no painel novo da Comtele: o número da rota de envio.
# COMTELE_ROTA=
# Para testar sem a Comtele: endereço de outro servidor que responde como ela.
# COMTELE_API_BASE=http://localhost:4000
# Como um lote anunciado entra na busca. "manual" (padrão): fica em análise até alguém aprovar no banco.
# "automatica": já entra ativo, para testar a negociação (é o que a versão de teste no Render usa).
# Outro valor impede a API de subir.
APROVACAO_LOTES=manual
# Onde ficam as fotos e vídeos dos anúncios: "cloudinary", "local" ou "desligado".
# Sem a variável: "cloudinary" se houver as credenciais do Cloudinary; "desligado" no Render; senão "local".
# MIDIA_ARMAZENAMENTO=local
# Conta do Cloudinary (painel do Cloudinary > Settings > API Keys): as três variáveis separadas...
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# ...ou tudo numa só, o "API environment variable" (se houver as duas formas, vale esta):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Modo local: pasta dos arquivos (padrão apps/api/uploads, fora do git). Caminho relativo vale a partir
# de onde a API roda (no "pnpm dev", apps/api), então prefira um caminho absoluto.
# MIDIA_PASTA_LOCAL=/home/voce/arroba-uploads
# Modo local: endereço da API que o app e o site enxergam, usado nos links das fotos. Para testar no
# celular, use o IP da máquina, como no app.
# API_URL_PUBLICA=http://localhost:3333

# Site (Next.js)
API_URL=http://localhost:3333

# App (Expo) — use o IP da sua máquina na rede para testar no celular
EXPO_PUBLIC_API_URL=http://localhost:3333
