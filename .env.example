# API
DATABASE_URL=postgres://arroba:arroba@localhost:5432/arroba_direta
PORT=3333
# Como o código de login chega ao usuário. "teste": sem SMS, o código aparece na tela do app.
# O envio por "sms" ainda não existe. Sem a variável vale "teste", exceto com NODE_ENV=production,
# em que a API não sobe sem ela.
CODIGO_MODO=teste

# Site (Next.js)
API_URL=http://localhost:3333

# App (Expo) — use o IP da sua máquina na rede para testar no celular
EXPO_PUBLIC_API_URL=http://localhost:3333
